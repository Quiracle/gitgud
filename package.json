{
  "name": "gitgud",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "supabase:bundle": "node scripts/bundle-edge-domain.mjs",
    "supabase:check": "pnpm supabase:bundle && supabase functions serve generate-daily-puzzle --env-file supabase/.env.local",
    "supabase:deploy": "pnpm supabase:bundle && supabase db push && supabase functions deploy generate-daily-puzzle --no-verify-jwt",
    "test": "vitest run --pool=threads --poolOptions.threads.singleThread=true",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.76.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "esbuild": "0.24.2",
    "postcss": "8.5.1",
    "supabase": "^2.120.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "5.4.14",
    "vitest": "2.1.8"
  }
}
